generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  USER
  ADMIN
  SUPER_ADMIN
}

enum OrderStatus {
  PENDING
  VALIDATED
  DELIVERED
  CANCELLED
}

/// Charges hors coût de production (matières gérées via achats / recettes)
enum CostType {
  DISTRIBUTION
  COMMERCIAL
  ADMINISTRATIVE
  OTHER
}

enum MaterialUnit {
  L
  KG
  PCS
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  phone        String?
  role         Role     @default(USER)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  orders          Order[]
  validatedOrders Order[]      @relation("ValidatedBy")
  deliveredOrders Order[]      @relation("DeliveredBy")
  costs           Cost[]
  productions     Production[]
  products        Product[]    @relation("CreatedProducts")
  purchases       Purchase[]
}

model Saveur {
  id        String    @id @default(cuid())
  name      String    @unique
  slug      String    @unique
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  products  Product[]
}

model FormatProduit {
  id        String    @id @default(cuid())
  name      String    @unique
  slug      String    @unique
  volumeMl  Int?
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  products  Product[]
}

model Product {
  id             String   @id @default(cuid())
  name           String
  description    String?
  imageUrl       String?
  unitPrice      Float    @default(0)
  /// Dernier coût de revient calculé (mis à jour à chaque production)
  productionCost Float    @default(0)
  stockQuantity  Int      @default(0)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  saveurId String
  saveur   Saveur @relation(fields: [saveurId], references: [id])
  formatId String
  format   FormatProduit @relation(fields: [formatId], references: [id])

  createdById String?
  createdBy   User?   @relation("CreatedProducts", fields: [createdById], references: [id])

  orderItems  OrderItem[]
  productions Production[]
  recipeItems ProductRecipeItem[]

  @@unique([saveurId, formatId])
}

model RawMaterial {
  id            String       @id @default(cuid())
  name          String       @unique
  unit          MaterialUnit @default(PCS)
  stockQuantity Float        @default(0)
  /// Coût unitaire moyen pondéré (CUMP)
  unitCost      Float        @default(0)
  isActive      Boolean      @default(true)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  purchases     Purchase[]
  recipeItems   ProductRecipeItem[]
  consumptions  ProductionConsumption[]
}

model Purchase {
  id          String   @id @default(cuid())
  quantity    Float
  unitPrice   Float
  totalAmount Float
  supplier    String?
  note        String?
  createdAt   DateTime @default(now())

  rawMaterialId String
  rawMaterial   RawMaterial @relation(fields: [rawMaterialId], references: [id])
  createdById   String
  createdBy     User        @relation(fields: [createdById], references: [id])
}

model ProductRecipeItem {
  id              String @id @default(cuid())
  quantityPerUnit Float

  productId     String
  product       Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  rawMaterialId String
  rawMaterial   RawMaterial @relation(fields: [rawMaterialId], references: [id])

  @@unique([productId, rawMaterialId])
}

model Order {
  id              String      @id @default(cuid())
  orderNumber     String      @unique
  status          OrderStatus @default(PENDING)
  totalAmount     Float       @default(0)
  notes           String?
  customerAddress String?
  customerPhone   String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  validatedAt     DateTime?
  deliveredAt     DateTime?

  userId String
  user   User   @relation(fields: [userId], references: [id])

  validatedById String?
  validatedBy   User?   @relation("ValidatedBy", fields: [validatedById], references: [id])

  deliveredById String?
  deliveredBy   User?   @relation("DeliveredBy", fields: [deliveredById], references: [id])

  items OrderItem[]
}

model OrderItem {
  id             String @id @default(cuid())
  quantity       Int
  unitPrice      Float
  /// Snapshot du coût de production au moment de la commande
  productionCost Float  @default(0)
  subtotal       Float

  orderId   String
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id])
}

model Production {
  id        String   @id @default(cuid())
  quantity  Int
  /// Coût de revient unitaire du lot (snapshot)
  unitCost  Float    @default(0)
  note      String?
  createdAt DateTime @default(now())

  productId   String
  product     Product @relation(fields: [productId], references: [id])
  createdById String
  createdBy   User    @relation(fields: [createdById], references: [id])

  consumptions ProductionConsumption[]
}

model ProductionConsumption {
  id        String @id @default(cuid())
  quantity  Float
  unitCost  Float
  totalCost Float

  productionId  String
  production    Production  @relation(fields: [productionId], references: [id], onDelete: Cascade)
  rawMaterialId String
  rawMaterial   RawMaterial @relation(fields: [rawMaterialId], references: [id])
}

model Cost {
  id          String    @id @default(cuid())
  type        CostType
  label       String
  amount      Float
  description String?
  periodStart DateTime?
  periodEnd   DateTime?
  createdAt   DateTime  @default(now())

  createdById String
  createdBy   User   @relation(fields: [createdById], references: [id])
}
